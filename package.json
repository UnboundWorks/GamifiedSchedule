{
  "name": "gamified-schedule",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-only, offline-first family schedule, chores, routines and gamification PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
